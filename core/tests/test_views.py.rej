+# --- Security audit follow-up tests ---
+
+@pytest.mark.django_db
+def test_signup_rejects_weak_password(client):
+    response = client.post(reverse('signup'), {
+        'role': 'patient',
+        'username': 'weakpwuser',
+        'email': 'weak@example.com',
+        'phone_number': '9998887777',
+        'password': '123',
+    })
+    assert response.status_code == 302
+    assert not User.objects.filter(username='weakpwuser').exists()
+
+
+@pytest.mark.django_db
+def test_signup_accepts_strong_password(client):
+    response = client.post(reverse('signup'), {
+        'role': 'patient',
+        'username': 'stronguser',
+        'email': 'strong@example.com',
+        'phone_number': '9998887778',
+        'password': 'aG3nuinely-Str0ng-Passw0rd!',
+    })
+    assert response.status_code == 302
+    assert User.objects.filter(username='stronguser').exists()
+
+
+@pytest.mark.django_db
+def test_login_locks_out_after_repeated_failures(client):
+    User.objects.create_user(username='lockouttest', password='correct-horse-battery-staple-1')
+    url = reverse('login')
+
+    for _ in range(10):
+        client.post(url, {'username': 'lockouttest', 'password': 'wrong-password'})
+
+    # 11th attempt, even with the CORRECT password, should now be blocked
+    response = client.post(url, {'username': 'lockouttest', 'password': 'correct-horse-battery-staple-1'}, follow=True)
+    messages_list = [str(m) for m in response.context['messages']]
+    assert any('Too many failed login attempts' in m for m in messages_list)
+
+
+@pytest.mark.django_db
+def test_login_succeeds_normally_under_the_limit(client):
+    User.objects.create_user(username='normallogin', password='correct-horse-battery-staple-2')
+    url = reverse('login')
+    response = client.post(url, {'username': 'normallogin', 'password': 'correct-horse-battery-staple-2'})
+    assert response.status_code == 302
