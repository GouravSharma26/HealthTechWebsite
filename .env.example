DJANGO_SECRET_KEY=your-django-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
EMAIL_HOST_USER=your-email-address
EMAIL_HOST_PASSWORD=your-email-app-password
GROQ_MODEL=openai/gpt-oss-20b
# Tried in order if the key can't use GROQ_MODEL (comma-separated)
GROQ_MODEL_FALLBACKS=openai/gpt-oss-120b
OPENROUTER_VISION_MODEL=google/gemini-3.7-flash
# Redis for Channels + cache. TLS providers need the rediss:// scheme.
REDIS_URL=
# Number of trusted reverse proxies appending to X-Forwarded-For (0 = legacy: trust first entry).
TRUSTED_PROXY_HOPS=0
# Password for the accounts created by create_sample_data.py (random one is generated if empty).
SAMPLE_DATA_PASSWORD=
# Render only: PYTHON_VERSION=3.12.11 (keep in sync with CI)
